{
  "manifest_version": 3,
  "name": "Cartiva",
  "version": "0.6.0",
  "key": "",
  "description": "Compare trustworthy Walmart, Target, and Kroger-family baskets, then build one retailer cart.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://www.target.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Cartiva"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.walmart.com/*"],
      "js": ["js/walmart-control-policy.js", "js/walmart-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.target.com/*"],
      "js": ["js/target-control-policy.js", "js/target-content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
