SERPAPI_API_KEY=
# Cartiva's fast Walmart provider. `decodo` remains available as an optional fallback.
WALMART_DATA_PROVIDER=serpapi
# Optional server-only Decodo Basic token for fallback experiments.
DECODO_AUTH_TOKEN=
# Server-only Parse API key for Target search and store availability.
# Never place this in extension files.
PARSEBOT_API_KEY=
TARGET_DATA_PROVIDER=parsebot
# Inactive legacy Target provider key retained only for rollback testing.
REDCIRCLE_API_KEY=
WALMART_STORE_ID=
WALMART_STORE_NAME=El Paso Walmart
WALMART_STORE_LOCATION=El Paso, TX
CARTIVA_EXTENSION_ID=
# Optional comma-separated loopback origins for extension UI development.
CARTIVA_EXTENSION_DEV_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Browser origins allowed to use the anonymous, read-only mobile API.
# Native Expo clients do not send a browser Origin header.
CARTIVA_MOBILE_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional custom web origin. Cartiva's current production origin and Vercel
# deployment origins are recognized automatically.
CARTIVA_PUBLIC_ORIGIN=

# Official Kroger Public API credentials. Keep these on the Cartiva server only.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Legacy loopback/extension callback. This URL must exactly match the Kroger app registration.
KROGER_REDIRECT_URI=http://localhost:3000/api/kroger/oauth/callback
# Production uses:
# https://cartiva-complete-cart.basedgodtetra.chatgpt.site/api/retailers/kroger/oauth/callback
# Enable cookie-backed Kroger sessions on non-Vercel serverless hosts.
CARTIVA_SERVERLESS_WEB_SESSION=false
# Generate at least 32 random characters. Signs the website OAuth state cookie.
CARTIVA_WEB_SESSION_SECRET=

# iPhone customer authorization requires a publicly reachable HTTPS Cartiva backend.
# Register this exact callback URL in the same Kroger developer application.
KROGER_MOBILE_REDIRECT_URI=https://api.example.com/api/mobile/v1/kroger/oauth/callback
# Production must use an HTTPS universal link claimed by the signed Cartiva
# iOS app (AASA), not the interceptable custom URL scheme. Development falls
# back to cartiva://oauth/kroger when this is blank.
CARTIVA_MOBILE_APP_RETURN_URI=https://api.example.com/oauth/kroger
# Generate at least 32 random characters. Server-only; never use EXPO_PUBLIC_ here.
CARTIVA_SESSION_SECRET=
# During a signing-key rotation, retain the immediately previous secret for at
# least the one-hour access-token lifetime so in-flight access/OAuth can finish.
CARTIVA_SESSION_PREVIOUS_SECRET=
# Explicit opt-in. Leave false until customer cart writing has been reviewed.
CARTIVA_ENABLE_KROGER_CART_WRITES=false
# Production local-file mode is valid only for exactly one backend process on
# one persistent encrypted volume. Multi-instance/serverless hosting requires
# a transactional shared-state adapter before cart writing can be enabled.
CARTIVA_SECURE_STATE_MODE=SINGLE_INSTANCE_FILESYSTEM
# Production cart writes also require a trusted rate-limiting edge that strips
# caller forwarding headers, sets the real client IP, and makes the backend
# origin unreachable directly. Never set true on an openly reachable origin.
CARTIVA_TRUSTED_EDGE=false
# Hash-only rotating anonymous-session recovery records.
CARTIVA_MOBILE_SESSION_FILE=
CARTIVA_MOBILE_OAUTH_STATE_DIR=
CARTIVA_MOBILE_OAUTH_COMPLETION_DIR=
CARTIVA_MOBILE_KROGER_SESSION_DIR=
CARTIVA_COMPARISON_RECEIPT_FILE=
KROGER_CART_RECEIPT_FILE=
