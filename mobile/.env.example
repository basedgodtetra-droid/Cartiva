# Public Cartiva backend origin only. Never put Kroger credentials in this file.
# For an iPhone on the same trusted network, use the computer's LAN address.
# Release builds must use an HTTPS Cartiva backend.
# Local Expo Go/development example. EAS builds require a deployed HTTPS origin.
EXPO_PUBLIC_CARTIVA_API_URL=http://192.168.1.10:3000
